# UPM Packages lock (ProjectSettings 아래 패키지 락 추적 제어)
/Packages/packages-lock.json

# Project settings autogenerated by Unity when using package manager
ProjectSettings/ProjectSettings.asset.meta

# ----------------------------------------------------
# [중요] EDM4U / External Dependency Manager (Play Services Resolver) 관련 무시 설정
# AdMob 등 서드파티 패키지가 생성하는 무수한 안드로이드 AAR/JAR 캐시 및 종속성 해결 산출물 깃 노출 방지
# ----------------------------------------------------
/ProjectSettings/AndroidResolverDependencies.xml
/Assets/PlayServicesResolver/
/Assets/ExternalDependencyManager/
/Assets/Plugins/Android/mainTemplate.gradle
/Assets/Plugins/Android/launcherTemplate.gradle
/Assets/Plugins/Android/gradleTemplate.properties

# Android Resolver가 Maven 저장소에서 자동 다운로드하여 캐싱하는 라이브러리 바이너리 무시
# (수동으로 직접 넣어준 타사 SDK AAR/JAR가 있다면 깃에서 제외되지 않도록 주의 필요)
/Assets/Plugins/Android/*.aar
/Assets/Plugins/Android/*.jar
/Assets/Plugins/Android/*.aar.meta
/Assets/Plugins/Android/*.jar.meta

# iOS CocoaPods 자동 생성물 및 빌드 파일 무시
/Assets/Plugins/iOS/Pods/
/Assets/Plugins/iOS/Podfile
/Assets/Plugins/iOS/Podfile.lock

